# Images / Renders (keep docs/assets/ if explicitly added later)
*.png
*.jpg
*.jpeg
*.webp
*.exr
*.hdr

# External GPL-3.0 Binaries & Local Tools (fetched via scripts/install_external_tools.sh)
/tools/
/bin/

# Credentials, SSH Keys & Local Session State
.ssh/
*id_ed25519*
colab_sessions.json
*.token
.env
.env.*
