# Python & Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Pipeline Runs, Caches & Heavy Outputs
runs/
outputs/
_cache/
_scratch/
scratch/
_colab_staging/
*.tar.gz
*.zip
*.part*

# 3D Assets, Checkpoints & Large Media (never commit weights or test models)
*.glb
*.gltf
*.fbx
*.obj
*.mtl
*.ply
*.stl
